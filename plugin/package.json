{
  "name": "@barneyzhaoooo/dsh-theme-codex",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BarneyZhaoooo/dsh-theme-codex.git"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "theme"
  ],
  "icon": "./icon.svg",
  "description": "Codex/Flexoki warm-neutral palette with custom accent, background and foreground, plus system font pickers for the DSH Web GUI.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.2",
    "react": "^18.2.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
